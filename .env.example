# Copy to .env at the repository root. These credentials are for local development only.
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot_local
POSTGRES_DB=copilot
POSTGRES_PORT=5433
COPILOT_DATABASE_URL=postgresql+psycopg://copilot:copilot_local@localhost:5433/copilot
COPILOT_LOG_LEVEL=INFO

# Optional until provider adapters are implemented. No paid calls are made by the smoke command.
# COPILOT_MODEL_ID=your-generation-model
# COPILOT_EMBEDDING_MODEL_ID=your-embedding-model
# COPILOT_EMBEDDING_DIMENSIONS=1536
# COPILOT_PROVIDER_API_KEY=your-key
COPILOT_MAX_TOOL_CALLS=12
COPILOT_MAX_CONTEXT_TOKENS=16000
COPILOT_MAX_OUTPUT_TOKENS=2000
COPILOT_RUN_TIMEOUT_SECONDS=90

# Ingestion limits (bytes unless otherwise named). Defaults also apply to existing .env files.
COPILOT_CLONE_TIMEOUT_SECONDS=60
COPILOT_INGESTION_TIMEOUT_SECONDS=180
COPILOT_MAX_CLONE_BYTES=104857600
COPILOT_MAX_FILE_BYTES=1048576
COPILOT_MAX_SOURCE_BYTES=20971520
COPILOT_MAX_REPOSITORY_FILES=10000

# Offline chunk budget uses a conservative UTF-8 byte upper bound for byte-level tokens.
COPILOT_MAX_CHUNK_TOKENS=1024
COPILOT_MAX_SNAPSHOT_CHUNKS=50000
COPILOT_PARSING_TIMEOUT_SECONDS=180
